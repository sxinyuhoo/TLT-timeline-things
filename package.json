{
  "name": "tlt-timeline-things",
  "version": "0.9.2",
  "description": "Obsidian plugin: timeline-first task manager with schedule, calendar, project milestones, workload and a message center (plain Markdown)",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "test": "node test/run.mjs && node test/render.mjs",
    "test:all": "node test/run.mjs && node test/render.mjs && node test/feed-lifecycle.mjs && node test/commands.mjs && node test/i18n.mjs && node test/rss-e2e.mjs && node test/py-service.mjs && node test/hub-e2e.mjs",
    "preview": "node test/preview.mjs",
    "play": "node test/play.mjs",
    "serve": "cd test && python3 -m http.server 8799",
    "serve:py": "python3 services-py/tlt_service.py --port 8787 --data ./services-py/data",
    "check:vault": "node test/vault-render.mjs",
    "check:load": "node test/plugin-load-check.mjs"
  },
  "devDependencies": {
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.0",
    "jsdom": "^30.1.3",
    "obsidian": "^1.7.2",
    "typescript": "^5.6.0"
  },
  "author": "sxinyuhoo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sxinyuhoo/TLT-timeline-things.git"
  },
  "keywords": [
    "obsidian",
    "timeline",
    "tasks",
    "calendar",
    "notes"
  ],
  "engines": {
    "node": ">=22"
  }
}
